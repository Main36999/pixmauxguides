RewriteEngine On

# ── Force HTTPS ──────────────────────────────────────────────────
# Skip/remove this block if your host already redirects HTTP -> HTTPS
# at the edge (most managed hosts do this automatically) -- leaving
# it in is harmless either way, it just won't fire.
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# g6.html -> whitespace-as-ui-component (slug renamed for SEO)
RewriteRule ^guide/g6\.html$ /guide/whitespace-as-ui-component [R=301,L]

# Consolidate any already-indexed/bookmarked .html guide URLs into the
# clean version, so SEO signals merge onto the one canonical URL.
RewriteCond %{THE_REQUEST} \s/+guide/([a-z0-9-]+)\.html[\s?] [NC]
RewriteRule ^ /guide/%1 [R=301,L]

# Serve the real .html file for the clean URL without changing what's
# shown in the address bar (internal rewrite, not a redirect).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^guide/([a-z0-9-]+)/?$ guide/$1.html [L]

# Same clean-URL treatment for the /category/<slug> archive pages
# (see build-categories.js) as /guide/<slug> gets above.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^category/([a-z0-9-]+)/?$ category/$1.html [L]

# Same clean-URL treatment for search.html as /guide/<slug> and
# /category/<slug> get above -- /search resolves to search.html without
# changing what's shown in the address bar.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^search/?$ search.html [L]

# Consolidate any already-shared /search.html?... link onto the clean
# /search URL, carrying the query string along (QSA).
RewriteCond %{THE_REQUEST} \s/+search\.html[\s?] [NC]
RewriteRule ^ /search [R=301,L,QSA]

# ── Security headers ─────────────────────────────────────────────
<IfModule mod_headers.c>
  # Force HTTPS for 2 years, including subdomains. Add "preload" only
  # after confirming HTTPS works everywhere on this domain, then submit
  # at https://hstspreload.org -- preload lists are hard to reverse.
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

  # Stop the browser guessing a file's content type (blocks some
  # MIME-sniffing based attacks, e.g. a .txt upload being run as JS)
  Header always set X-Content-Type-Options "nosniff"

  # Block every page on this site from being embedded in an <iframe>
  # on another site (clickjacking protection). CSP's frame-ancestors
  # below does the same job for modern browsers; this covers older ones.
  Header always set X-Frame-Options "DENY"

  # Cross-origin requests get only the origin, not the full URL/path
  # (keeps query strings and page paths from leaking to other sites)
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Turn off browser features this site never uses
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

  # Content-Security-Policy -- deployed in REPORT-ONLY mode first.
  # It won't block anything yet; it just logs would-be violations to
  # the browser DevTools console (Console tab) so you can verify
  # nothing on the site (Cookiebot, gtag, the contact form, guides.json)
  # gets caught by mistake before switching to enforcement. See the
  # notes below the file for how and when to flip it on.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://consent.cookiebot.com https://*.cookiebot.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.cookiebot.com; font-src 'self'; connect-src 'self' https://formspree.io https://www.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com https://*.cookiebot.com; frame-src https://consent.cookiebot.com https://*.cookiebot.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
</IfModule>
